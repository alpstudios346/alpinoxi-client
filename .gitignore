# Build output, never source.
/build/
/out/
/CMakeCache.txt
/CMakeFiles/
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.log
.env
.idea/
.vscode/

# Gradle / Java mod builds
.gradle/
build/
!mods/*/build.gradle*
!mods/*/gradle.properties
out/
*.class
*.iml
# Compiled jars from mods/jars/build.sh: build output, not source.
mods/jars/*.jar
mods/jars/*/classes/
mods/jars/*.sources
mods/jars/*.args

# The backup tree is a copy of everything, so the rules above must not carve
# holes in it: a backup with missing files is worse than none.
!backups/
!backups/**
