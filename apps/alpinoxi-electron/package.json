{
  "name": "alpinoxi-client-desktop",
  "productName": "Alpinoxi Client",
  "version": "0.3.0",
  "description": "Alpinoxi Client: the launcher window",
  "main": "main.js",
  "author": "AlpinoxiGD",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "net.alpinoxi.client",
    "productName": "Alpinoxi Client",
    "directories": {
      "output": "../../dist/electron",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Alpinoxi Client"
    }
  }
}
